# Copy to .env.local. Restart `npm run dev` (or rebuild) after changing — NEXT_PUBLIC_ values are baked in at build time.

# Staff drawer PIN, checked on the server.
STAFF_PIN="1234"

# Formspree form endpoint for the instant order email, e.g. https://formspree.io/f/abcdwxyz
# Leave empty to skip the email.
NEXT_PUBLIC_FORMSPREE_URL=""

# Optional phone ping on each order. The order text is sent as the `text` query param (GET).
#   CallMeBot WhatsApp: https://api.callmebot.com/whatsapp.php?phone=971XXXXXXXXX&apikey=YOUR_KEY
#   Telegram bot:       https://api.telegram.org/botYOUR_TOKEN/sendMessage?chat_id=YOUR_CHAT_ID
# Leave empty to skip; failures are logged and never block an order.
WHATSAPP_WEBHOOK_URL=""
